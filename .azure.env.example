# Azure deploy configuration for the scripts under scripts/.
#
#   cp .azure.env.example .azure.env
#
# .azure.env is gitignored — keep the real values out of version control.

# Required. The subscription every deploy in this project targets.
# The owner has multiple subscriptions and `az account show` is not a reliable
# source of truth, so the scripts refuse to guess.
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Optional overrides — the scripts have sensible defaults for these.
# LOCATION=centralus
# LOCATION_SHORT=cus
# NAME_PREFIX=ctax
# ENV_NAME=demo
