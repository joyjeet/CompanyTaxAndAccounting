# ----- App (runtime) -----
APP_ENV=local
APP_LOG_LEVEL=INFO

# ----- Authentication -----
# 'jwt' for production (Entra ID / OIDC); 'test' for local + CI.
APP_AUTH_MODE=test

# Where firm/client/scope come from AFTER the token is verified.
#   claims     = read them from the token. Needs directory extension
#                attributes + a claims-mapping policy, and revocation only
#                takes effect when the token expires.
#   membership = resolve them from the firm_membership table. Removing someone
#                takes effect on their next request. Use this in production.
# The frontend's VITE_AUTHZ_SOURCE must be set to the same value.
APP_AUTHZ_SOURCE=claims

# Entra ID / OIDC (required when APP_AUTH_MODE=jwt). Issuer / audience must
# EXACTLY match the values in tokens issued by the directory; mismatches
# fail validation. JWKS URL is the directory's public-key endpoint.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_JWKS_CACHE_SECONDS=3600

# Claim names (override only if your directory uses non-default custom claims).
OIDC_CLAIM_FIRM_ID=firm_id
OIDC_CLAIM_CLIENT_ID=client_id
OIDC_CLAIM_ROLES=roles
# Role values that map to FIRM vs CLIENT scope.
OIDC_ROLE_FIRM=firm_staff
OIDC_ROLE_CLIENT=client_portal

# HS256 secrets used by the test-mode provider. NEVER set these in prod.
APP_TEST_JWT_SECRET=test-only-do-not-use-in-prod
APP_TEST_JWT_ISSUER=ctaa-test
APP_TEST_JWT_AUDIENCE=ctaa-api

# ----- Encryption / KEK -----
# 'local' derives a per-firm KEK from APP_LOCAL_KEK_MASTER (HKDF). Suitable
# for tests / dev. 'keyvault' uses a per-firm key in Azure Key Vault.
APP_KEK_PROVIDER=local
APP_LOCAL_KEK_MASTER=test-only-master-do-not-use-in-prod

# Azure Key Vault (when APP_KEK_PROVIDER=keyvault). Use a Managed Identity
# in prod; do NOT put credentials in env. {firm_id} is replaced per tenant.
AZURE_KEYVAULT_URL=
AZURE_KEYVAULT_KEY_NAME_TEMPLATE=ctaa-firm-{firm_id}

# ----- Database -----
# Runtime app role — non-superuser, no BYPASSRLS.
DATABASE_URL=postgresql+psycopg://app_user:app_password@db:5432/ctaa
# Owner role — used ONLY for migrations / schema changes.
DATABASE_OWNER_URL=postgresql+psycopg://ctaa_owner:owner_password@db:5432/ctaa

# ----- Postgres bootstrap (used by docker-compose to init the DB) -----
POSTGRES_DB=ctaa
POSTGRES_OWNER_USER=ctaa_owner
POSTGRES_OWNER_PASSWORD=owner_password
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=app_password
# Superuser only used by the container during init.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ----- Redis (worker queue stub) -----
REDIS_URL=redis://redis:6379/0
