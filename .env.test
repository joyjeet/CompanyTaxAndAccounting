# Environment for running the test suite on the HOST (not in Docker).
#
# The suite TRUNCATES every tenant table before each test, so it must never
# point at the dev database (`ctaa`) — doing so silently destroys your seeded
# demo data. This file targets a throwaway `ctaa_test` database instead.
#
# One-time setup:
#   make test-db
#
# Then run the suite with:
#   make test-local
#
# Credentials below are local-only throwaways and mirror the roles CI uses in
# .github/workflows/tests.yml. Nothing here reaches Azure: the categorizer and
# extractor backends stay on their stub defaults.

APP_ENV=test
APP_LOG_LEVEL=INFO
APP_AUTH_MODE=test
APP_AUTHZ_SOURCE=claims

APP_TEST_JWT_SECRET=local-test-secret-not-for-production
APP_TEST_JWT_ISSUER=ctaa-test
APP_TEST_JWT_AUDIENCE=ctaa-api

APP_KEK_PROVIDER=local
APP_LOCAL_KEK_MASTER=test-only-master-do-not-use-in-prod

DATABASE_URL=postgresql+psycopg://app_user_test:app_user_test@localhost:5432/ctaa_test
DATABASE_OWNER_URL=postgresql+psycopg://ctaa_owner_test:owner_test@localhost:5432/ctaa_test
