# ----- Frontend env -----
# 'dev' = use the backend's /auth/dev-token endpoint with a role/firm picker.
# 'msal' = use Entra ID auth-code/PKCE via @azure/msal-browser.
VITE_AUTH_MODE=dev

# Base URL for API calls. Leave empty in dev to use the Vite proxy at /api.
VITE_API_BASE=/api

# ----- MSAL (only used when VITE_AUTH_MODE=msal) -----
# Application (client) ID from the Entra ID App Registration.
VITE_MSAL_CLIENT_ID=
# Authority URL: https://login.microsoftonline.com/<tenant-id>
VITE_MSAL_AUTHORITY=
# Scopes the SPA requests. Typically the API's app-id-uri + ".default", or
# a custom scope like "api://<api-client-id>/access".
VITE_MSAL_API_SCOPE=
# Redirect URI registered on the App Registration (must match exactly).
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# ----- Dev-mode defaults (used by the dev login form) -----
# A pre-filled firm UUID makes the dev login screen one-click. Optional.
VITE_DEV_DEFAULT_FIRM_ID=
VITE_DEV_DEFAULT_CLIENT_ID=
